VPATH=make
TOOL=innovus -64
SCRIPTS=../scripts
LOG=../logs


all: setup init place cts postcts_hold route

setup:
	mkdir -p $(VPATH) $(LOG)
	touch $(VPATH)/$@

# init and floorplan
init: setup
	mkdir -p $(LOG);
	VPATH=$(VPATH); export VPATH; $(TOOL) -init $(SCRIPTS)/run_init.tcl -log $(LOG)/init.log -overwrite

# simple: setup
# 	FF_STOP=$(FF_STOP); VPATH=$(VPATH); export VPATH; $(TOOL) -init $(SCRIPTS)/run_simple.tcl -log $(LOG)/simple.log

# single: setup
# 	FF_STOP=$(FF_STOP); VPATH=$(VPATH); export VPATH; $(TOOL) -init $(SCRIPTS)/run_all.tcl -log $(LOG)/single.log

# place: init
place:
	mkdir -p $(LOG);
	VPATH=$(VPATH); export VPATH; $(TOOL) -init $(SCRIPTS)/run_place.tcl -log $(LOG)/place.log -overwrite

cts: place
	mkdir -p $(LOG);
	VPATH=$(VPATH); export VPATH; $(TOOL) -init $(SCRIPTS)/run_cts.tcl -log $(LOG)/cts.log -overwrite

# postcts_hold: cts
# 	mkdir -p $(LOG);
# 	VPATH=$(VPATH); export VPATH; $(TOOL) -init $(SCRIPTS)/run_postcts_hold.tcl -log $(LOG)/postcts_hold.log -overwrite

route:postcts_hold
	mkdir -p $(LOG);
	VPATH=$(VPATH); export VPATH; $(TOOL) -init $(SCRIPTS)/run_route.tcl -log $(LOG)/route.log -overwrite
